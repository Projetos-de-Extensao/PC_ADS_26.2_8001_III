# Copie para .env e preencha. NUNCA commite o .env.
POSTGRES_DB=apollo
POSTGRES_USER=apollo
POSTGRES_PASSWORD=troque-esta-senha
# POSTGRES_HOST é definido como "db" no docker-compose.yml

SECRET_KEY=gere-com-python-c-"import secrets;print(secrets.token_urlsafe(50))"
DEBUG=False
# IP público/Elastic IP da EC2 ou domínio (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1,SEU_IP_PUBLICO
# Necessário só se usar HTTPS/domínio, ex.: https://apollo.exemplo.com
CSRF_TRUSTED_ORIGINS=

# Superusuário do /admin (criado na primeira subida)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha-tambem
DJANGO_SUPERUSER_EMAIL=admin@apollo.local
